{
  "info": {
    "name": "ORBIT Partner Dispatch API & Socket Suite",
    "description": "Production-Grade Uber/Ola-Style Nearby Partner Dispatch Collection for ORBIT Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "jwtToken", "value": "PASTE_GENERATED_CLIENT_JWT_TOKEN_HERE", "type": "string" },
    { "key": "bookingId", "value": "orb_demo_123456", "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "Operational Metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/metrics", "host": ["{{baseUrl}}"], "path": ["metrics"] }
      }
    },
    {
      "name": "Create Booking & Dispatch Partner (Async)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lat\": 19.0760,\n  \"lng\": 72.8777,\n  \"address\": \"Bandra West, Mumbai, Maharashtra\",\n  \"price\": 499\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
      }
    },
    {
      "name": "Create Booking & Dispatch Partner (Sync)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lat\": 19.0760,\n  \"lng\": 72.8777,\n  \"address\": \"Bandra West, Mumbai, Maharashtra\",\n  \"price\": 499\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/bookings?sync=true", "host": ["{{baseUrl}}"], "path": ["api", "bookings"], "query": [{ "key": "sync", "value": "true" }] }
      }
    },
    {
      "name": "Get Booking Details",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}"] }
      }
    },
    {
      "name": "Update Booking Status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"EN_ROUTE\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}", "status"] }
      }
    },
    {
      "name": "Cancel Booking",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Client change of plans\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "{{bookingId}}", "cancel"] }
      }
    }
  ]
}
