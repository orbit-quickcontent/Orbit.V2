{
  "name": "orbit-standalone-backend",
  "version": "1.0.0",
  "description": "Unified standalone Express API and WebSocket backend for Orbit",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register --transpile-only src/server.ts",
    "build": "prisma generate",
    "start": "ts-node -r tsconfig-paths/register --transpile-only src/server.ts",
    "render-build": "npm install && prisma generate",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@supabase/supabase-js": "^2.112.3",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^10.3.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "prisma": "^6.11.1",
    "socket.io": "^4.7.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^6.4.14",
    "next": "^16.3.0",
    "next-auth": "^4.24.14",
    "vitest": "^4.1.10"
  }
}
