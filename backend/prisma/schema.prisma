generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  displayName  String?
  phone        String?
  location     String?
  role         String    @default("CLIENT")
  brandLogo    String?
  brandFont    String?
  brandColor   String?
  editorRequirements String?
  avatar       String?
  photoURL     String?
  passwordHash String?
  status       String    @default("ACTIVE")
  walletBalance Float    @default(0.0)
  rating       Float     @default(0.0)
  kycStatus    String    @default("UNVERIFIED")
  deviceType   String?
  deviceId     String?
  appVersion   String?
  fcmToken     String?
  lastLogin    DateTime?
  lastSeen     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  bookings     Booking[]
  partner      Partner?
  auditLogs    AuditLog[]

  @@index([role])
}

model Package {
  id           String   @id @default(cuid())
  name         String
  tier         String   @unique
  price        Int
  focus        String
  deliveryTime String
  features     String
  popular      Boolean  @default(false)
  partnerPayoutAmount Int @default(700)
  editorPayoutAmount  Int @default(0)
  taxAmount          Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings     Booking[]
}

model Partner {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  location          String
  latitude          Float?
  longitude         Float?
  lastSeenAt        DateTime?
  lastLocationAt    DateTime?
  availability      Boolean  @default(true)
  isVerified        Boolean  @default(false)
  rating            Float    @default(0.0)
  completedProjects Int      @default(0)
  deviceInfo        String?
  accountHolderName      String?
  encryptedAccountNumber String?
  ifscCode               String?
  bankName               String?
  branchName             String?
  panNumber              String?
  verificationStatus     String    @default("UNVERIFIED")
  verificationMethod    String?
  verificationReference String?
  verifiedAt             DateTime?
  payoutEnabled          Boolean   @default(false)
  walletBalance         Float     @default(0.0)
  pendingClearance      Float     @default(0.0)
  totalWithdrawn        Float     @default(0.0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  bookings       Booking[]
  workDispatches WorkDispatch[]
  transactions   Transaction[]
  partnerEarnings PartnerEarning[]

  @@index([availability, isVerified])
  @@index([latitude, longitude])
  @@index([lastSeenAt])
}

model Booking {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  packageId        String
  package          Package  @relation(fields: [packageId], references: [id])
  partnerId        String?
  partner           Partner? @relation(fields: [partnerId], references: [id])
  editorId         String?
  editorAssignedAt DateTime?
  status           String   @default("PENDING")
  paymentStatus    String   @default("UNPAID")
  paymentId        String?
  paymentMethod    String?
  bookingDate      DateTime
  timeSlot         String
  location         String?
  latitude         Float?
  longitude        Float?
  syncPercentage   Int      @default(0)
  editCountdown    Int?
  deliveredAt      DateTime?
  cancelledBy      String?
  deletedAt        DateTime?
  notes            String?
  footageUrls      String?
  masterReelUrl    String?
  hlsPlaylistUrl   String?
  proxyFootageUrl  String?
  dispatchRound    Int      @default(0)
  declinedBy       String?
  partnerEarningAmount Int @default(700)
  platformCommissionAmount Int @default(0)
  taxAmount        Int @default(0)
  editorPayoutAmount Int @default(0)
  partnerEarningStatus String @default("PENDING")
  partnerEarningAvailableAt DateTime?
  partnerPaidAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workDispatches WorkDispatch[]
  partnerEarning PartnerEarning?

  @@index([userId])
  @@index([partnerId])
  @@index([editorId])
  @@index([status])
  @@index([partnerEarningStatus])
  @@index([createdAt])
}

model WorkDispatch {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id])
  partnerId    String
  partner      Partner  @relation(fields: [partnerId], references: [id])
  status       String   @default("PENDING")
  dispatchedAt DateTime @default(now())
  expiresAt    DateTime?
  respondedAt  DateTime?
  round        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([bookingId])
  @@index([partnerId])
  @@index([status])
  @@index([expiresAt])
  @@unique([bookingId, partnerId, round])
}

model PartnerEarning {
  id                     String   @id @default(cuid())
  bookingId              String   @unique
  booking                Booking  @relation(fields: [bookingId], references: [id])
  partnerId              String
  partner                Partner  @relation(fields: [partnerId], references: [id])
  grossAmount             Int
  platformCommissionAmount Int
  taxAmount              Int
  editorPayoutAmount      Int
  partnerEarningAmount    Int
  status                  String   @default("PENDING")
  availableAt             DateTime?
  paidAt                  DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([partnerId, status])
  @@index([createdAt])
}

model Transaction {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id])
  bookingId   String?
  type        String
  amount      Float
  status      String   @default("COMPLETED")
  description String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  @@index([partnerId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
