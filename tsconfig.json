{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "*": [
        "node_modules/*",
        "dashboard-web-app/node_modules/*",
        "backend/node_modules/*"
      ]
    }
  },
  "include": [
    "backend/**/*",
    "dashboard-web-app/**/*",
    "editor-web-app/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules"
  ]
}
