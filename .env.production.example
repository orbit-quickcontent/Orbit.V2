# =========================================================================
# ORBIT PLATFORM — Production Environment Configuration (.env.production)
# =========================================================================

# -------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL — Supabase / Neon)
# -------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-DB-HOST].supabase.co:5432/postgres?sslmode=require"
CLIENT_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-DB-HOST].supabase.co:5432/postgres?sslmode=require"
PARTNER_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-DB-HOST].supabase.co:5432/postgres?sslmode=require"

# -------------------------------------------------------------------------
# 2. Server & Public URLs
# -------------------------------------------------------------------------
NODE_ENV="production"
PORT=5000
WS_PORT=3003
FRONTEND_PORT=3000
DOMAIN="orbit-quickcontent.com"
NEXT_PUBLIC_APP_URL="https://orbit-quickcontent.com"
NEXT_PUBLIC_API_URL="https://api.orbit-quickcontent.com"
NEXT_PUBLIC_WS_URL="wss://api.orbit-quickcontent.com"

# -------------------------------------------------------------------------
# 3. Authentication & Security
# -------------------------------------------------------------------------
NEXTAUTH_SECRET="[GENERATE-RANDOM-64-CHAR-HEX-OR-BASE64-SECRET]"
JWT_SECRET="[GENERATE-RANDOM-64-CHAR-HEX-OR-BASE64-SECRET]"
ENCRYPTION_KEY="[32-BYTE-HEX-KEY-FOR-BANK-ACCOUNT-ENCRYPTION]"

# -------------------------------------------------------------------------
# 4. Email Server (SMTP — Gmail / SendGrid / Brevo)
# -------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="[YOUR-16-CHAR-APP-PASSWORD]"
SMTP_FROM="noreply@orbit-quickcontent.com"

# -------------------------------------------------------------------------
# 5. Payment Gateway (Razorpay Live Keys)
# -------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# -------------------------------------------------------------------------
# 6. Cloud Storage (Cloudflare R2 / AWS S3)
# -------------------------------------------------------------------------
CLOUDFLARE_R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLOUDFLARE_R2_BUCKET_NAME="orbit-quickcontent-storage"
CLOUDFLARE_R2_ENDPOINT="https://[BUCKET-ID].r2.cloudflarestorage.com"

# -------------------------------------------------------------------------
# 7. Error Tracking & Monitoring (Sentry)
# -------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxxxxxxxxxxx@o123456.ingest.sentry.io/1234567"
