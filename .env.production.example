# =========================================================================
# ORBIT PLATFORM — Production Environment Configuration (.env.production)
# Set these in your hosting provider's dashboard (Vercel, Railway, etc.)
# =========================================================================

# ─── 1. Server & Public URLs ────────────────────────────────────────────
NODE_ENV=production
PORT=5000
WS_PORT=3003
DOMAIN=orbit-quickcontent.com
NEXT_PUBLIC_APP_URL=https://app.orbit-quickcontent.com
NEXT_PUBLIC_API_URL=https://api.orbit-quickcontent.com/api
NEXT_PUBLIC_WS_URL=wss://api.orbit-quickcontent.com

# ─── 2. Authentication & Security ──────────────────────────────────────
JWT_SECRET=[GENERATE-RANDOM-64-CHAR-HEX]
NEXTAUTH_SECRET=[GENERATE-RANDOM-64-CHAR-HEX]
ENCRYPTION_KEY=[32-BYTE-HEX-KEY-FOR-BANK-ACCOUNT-ENCRYPTION]
INTERNAL_WS_SECRET=[RANDOM-SECRET-FOR-WS-INTERNAL-ENDPOINTS]

# ─── 3. Firebase ────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ─── 4. Payment Gateway (Razorpay Live Keys) ────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── 5. Email (Resend / Postmark) ───────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
SMTP_FROM=noreply@orbit-quickcontent.com

# ─── 6. Cloud Storage (Cloudflare R2 / AWS S3) ──────────────────────────
CLOUDFLARE_R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_BUCKET_NAME=orbit-quickcontent-storage
CLOUDFLARE_R2_ENDPOINT=https://[BUCKET-ID].r2.cloudflarestorage.com

# ─── 7. Error Tracking & Monitoring ────────────────────────────────────
SENTRY_DSN=https://xxx@oXX.ingest.sentry.io/xxxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXX.ingest.sentry.io/xxxxxx

# ─── 8. Analytics ──────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── 9. Maps ───────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPLIBRE_STYLE=https://tiles.openfreemap.org/styles/liberty

# ─── REMOVED ───────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL       — DELETED (Supabase removed)
# NEXT_PUBLIC_SUPABASE_ANON_KEY  — DELETED
# SUPABASE_SERVICE_ROLE_KEY      — DELETED
# DATABASE_URL (Supabase PG)     — DELETED (Firebase/Firestore is the DB)
# CLIENT_DATABASE_URL            — DELETED
# PARTNER_DATABASE_URL           — DELETED
