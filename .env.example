# =========================================================================
# ORBIT PLATFORM — Unified Environment Configuration (.env.example)
# Copy to .env (local) or set these in your hosting provider's dashboard.
# NEVER commit .env files with real secrets to git.
# =========================================================================

# ─── 1. Ports (backend) ────────────────────────────────────────────────
BACKEND_PORT=5000
PORT=5000
WS_PORT=3003
NODE_ENV=development

# ─── 2. Frontend / Next.js Public Endpoints ────────────────────────────
# On Vercel, set NEXT_PUBLIC_API_URL to your deployed backend URL.
# On local dev, the Next.js rewrite proxy to localhost:5000 is used automatically.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_WS_URL=http://localhost:3003
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── 3. Mobile (Android / iOS) ─────────────────────────────────────────
# Override per build variant in build.gradle / Info.plist
ORBIT_API_URL=https://app.orbit-quickcontent.com/api

# ─── 4. Authentication Secrets ─────────────────────────────────────────
# REQUIRED — app will refuse to start if these are missing
JWT_SECRET=change-me-to-a-random-64-char-secret
NEXTAUTH_SECRET=change-me-to-a-random-64-char-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Internal WebSocket endpoint auth secret (set to any random string in production)
INTERNAL_WS_SECRET=change-me-optional-but-recommended

# ─── 5. Firebase (client + backend) ────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ─── 6. Map / Vector Tiles ─────────────────────────────────────────────
NEXT_PUBLIC_MAPLIBRE_STYLE=https://tiles.openfreemap.org/styles/liberty

# ─── 7. Payment (Razorpay) ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── 8. Notifications ──────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ─── 9. Error Monitoring ───────────────────────────────────────────────
SENTRY_DSN=https://xxx@oXX.ingest.sentry.io/xxxxxx

# ─── 10. Analytics ─────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── REMOVED ───────────────────────────────────────────────────────────
# Supabase is no longer used. Remove any SUPABASE_* vars from your environment.
# NEXT_PUBLIC_SUPABASE_URL   — DELETED
# NEXT_PUBLIC_SUPABASE_ANON_KEY — DELETED
# SUPABASE_SERVICE_ROLE_KEY  — DELETED
# CLIENT_DATABASE_URL        — DELETED
# PARTNER_DATABASE_URL       — DELETED
