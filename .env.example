# =========================================================================
# ORBIT PLATFORM — Unified Environment Configuration (.env.example)
# =========================================================================

# ─── 1. Shared / Ports ────────────────────────────────────
BACKEND_PORT=5000
PORT=5000
WS_PORT=3003
FRONTEND_PORT=3000
NODE_ENV=development

# ─── 2. Frontend & Next.js Public Endpoints ───────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_WS_URL=ws://localhost:3003
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── 3. Mobile (Android / Flutter) ────────────────────────
FLUTTER_API_URL=http://localhost:5000/api
FLUTTER_WS_URL=ws://localhost:3003
MOBILE_API_URL=http://10.0.2.2:5000/api

# ─── 4. Database (PostgreSQL / Supabase / SQLite Fallback)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbit"
CLIENT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbit"
PARTNER_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbit"

# ─── 5. Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── 6. Authentication Secrets ───────────────────────────
NEXTAUTH_SECRET="orbit_dev_secret_key_change_in_production_32chars"
JWT_SECRET="orbit_jwt_secret_key_change_in_production_32chars"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ─── 7. Map & Vector Tile Config ─────────────────────────
NEXT_PUBLIC_MAPLIBRE_STYLE="https://tiles.openfreemap.org/styles/liberty"
