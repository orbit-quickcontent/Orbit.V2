# Environment Variables Example for ORBIT Platform

PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://orbit:orbitsecret@localhost:5432/orbit_db?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=orbit_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d

CORS_ORIGIN="*"
DISPATCH_TIMEOUT_SECONDS=15
DISPATCH_RADIUS_KM=10

NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
