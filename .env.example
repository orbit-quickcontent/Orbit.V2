# ==============================================================================
# ORBIT Production & Development Environment Configuration
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=orbit_super_secret_jwt_key_change_in_production_2026

# Redis (Geo Presence & Distributed Locks)
REDIS_URL=redis://127.0.0.1:6379

# Routing & Free Map Services (Configurable for self-hosted or public instances)
OSRM_URL=https://router.project-osrm.org
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5000,http://10.0.2.2:5000

# Dispatch Engine Parameters
NEARBY_RADIUS_KM=5
MAX_NEARBY_PARTNERS=20
PARTNER_STALE_SECONDS=60
LOCATION_MIN_INTERVAL_SECONDS=3
DISPATCH_OFFER_SECONDS=20
DISPATCH_BATCH_SIZE=3
ROUTE_CACHE_SECONDS=45

# Database (PostgreSQL / Firestore Adapter)
DATABASE_URL=postgresql://orbit:orbitsecret@localhost:5432/orbit_db?schema=public
