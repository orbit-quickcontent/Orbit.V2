# Server Environment Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# JWT Authentication
JWT_SECRET=orbit_super_secret_jwt_key_2026_production_ready
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=orbit_super_secret_refresh_jwt_key_2026

# Redis GEO & Cache Store
REDIS_URL=redis://127.0.0.1:6379

# Dispatch Engine Config
DISPATCH_TIMEOUT_SECONDS=15
LOCATION_STALE_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
